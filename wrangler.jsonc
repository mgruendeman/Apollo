// Cloudflare deploy config. The site is the Vite build in dist/ (built with
// BASE_PATH=/, see vite.config.js); worker/index.js answers /api/* (likes,
// problem reports, photo review marks) and everything else is static files.
// Secrets REVIEW_PASSWORD and HASH_SALT are set in the Cloudflare dashboard.
{
  "name": "apollo",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // the site's front page goes through the worker first, so it can count each request (a browser or
    // a bot) before handing the page back; every other file is served straight from the assets
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "apollo", "database_id": "703693ee-8eb7-4d16-afa2-9957dca612d0" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "apollo-media" }
  ],
  // Preview builds (any branch but the production one) use the live
  // database and tapes too: reports sent from a preview reach the same list.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_id": "703693ee-8eb7-4d16-afa2-9957dca612d0" }
    ],
    "r2_buckets": [
      { "binding": "MEDIA", "bucket_name": "apollo-media" }
    ]
  }
}
